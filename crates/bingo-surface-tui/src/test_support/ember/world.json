  "sessions": [
    {
      "t": "bingo-site 文档页",
      "dir": "~/bingo-site",
      "when": "3m",
      "st": "working"
    },
    {
      "t": "飞书卡片按钮回调",
      "dir": "~/bingo-improve",
      "when": "40m",
      "st": "asking"
    },
    {
      "t": "steer 吞掉排队消息",
      "dir": "~/bingo-improve",
      "when": "12m"
    },
    {
      "t": "给 total 加标签",
      "dir": "~/total",
      "when": "2h"
    },
    {
      "t": "release v0.6.3",
      "dir": "~/bingo-improve",
      "when": "Sep 15"
    },
    {
      "t": "axum 路由迁移",
      "dir": "~/api",
      "when": "Sep 12"
    },
    {
      "t": "blender 场景灯光",
      "dir": "~/blender_demo",
      "when": "Sep 9"
    },
    {
      "t": "windows CI 超时",
      "dir": "~/bingo-improve",
      "when": "Sep 3"
    },
    {
      "t": "cargo deny 报 rustls",
      "dir": "~/bingo-improve",
      "when": "Aug 30"
    }
  ],
  "tasks": [
    {
      "id": 5,
      "t": "审一遍 queue 的改动",
      "st": "pending",
      "who": "reviewer"
    },
    {
      "id": 4,
      "t": "补 steer 之后排队的回归测试",
      "st": "in_progress",
      "who": "bingo"
    },
    {
      "id": 3,
      "t": "找出所有调用 drain() 的地方",
      "st": "in_progress",
      "who": "scout"
    },
    {
      "id": 2,
      "t": "修 reset() 清空队列",
      "st": "completed",
      "who": "bingo"
    },
    {
      "id": 1,
      "t": "复现消息被吞",
      "st": "completed",
      "who": "you"
    }
  ],
  "scheds": [
    {
      "when": "every 30m",
      "what": "看一眼 CI，挂了就告诉我",
      "next": "in 12m",
      "on": true
    },
    {
      "when": "daily 09:00",
      "what": "总结昨天合进 dev 的提交",
      "next": "tomorrow 09:00",
      "on": true
    },
    {
      "when": "once Fri 18:00",
      "what": "提醒我发 v0.6.4",
      "next": "Fri 18:00",
      "on": false
    }
  ],
  "memory": [
    {
      "kind": "instructions",
      "t": "AGENTS.md",
      "d": "this project · 64 lines"
    },
    {
      "kind": "instructions",
      "t": "~/.bingo/AGENTS.md",
      "d": "every project · 12 lines"
    },
    {
      "kind": "memory",
      "t": "在 dev 上开发，main 是发布线",
      "d": "Sep 2"
    },
    {
      "kind": "memory",
      "t": "测试别钉墙上的时钟，CI 更慢",
      "d": "Sep 11"
    },
    {
      "kind": "memory",
      "t": "提交信息用英文，主题不超过 60 个字符",
      "d": "Aug 30"
    }
  ],
  "modes": [
    {
      "n": "default",
      "c": "muted",
      "d": "trusted read-only tools run; everything else asks"
    },
    {
      "n": "accept edits",
      "c": "auto",
      "d": "edits inside the working directories run without a prompt"
    },
    {
      "n": "plan",
      "c": "plan",
      "d": "nothing that is not read-only runs at all"
    },
    {
      "n": "bypass",
      "c": "bad",
      "d": "everything runs except what only a person may decide"
    }
  ],
  "roster": [
    {
      "name": "scout",
      "c": "crew1",
      "role": "finds things in the codebase",
      "model": {
        "id": "haiku-5.5",
        "eff": "low"
      }
    },
    {
      "name": "reviewer",
      "c": "crew2",
