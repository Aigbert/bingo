  "plugins": [
    {
      "n": "tool-fs",
      "d": "read, edit and write files",
      "on": true,
      "kind": "built in"
    },
    {
      "n": "tool-bash",
      "d": "run shell commands",
      "on": true,
      "kind": "built in"
    },
    {
      "n": "tool-web",
      "d": "fetch pages and search the web",
      "on": true,
      "kind": "built in"
    },
    {
      "n": "agents",
      "d": "hire agents and give them work",
      "on": true,
      "kind": "built in"
    },
    {
      "n": "rooms",
      "d": "rooms where agents and you talk",
      "on": true,
      "kind": "built in"
    },
    {
      "n": "schedule",
      "d": "prompts that run on a clock",
      "on": true,
      "kind": "built in"
    },
    {
      "n": "experience",
      "d": "learns from your corrections",
      "on": false,
      "kind": "built in"
    },
    {
      "n": "feishu",
      "d": "talk to this session from Feishu",
      "on": true,
      "kind": "channel"
    },
    {
      "n": "github",
      "d": "issues, pull requests and checks",
      "on": true,
      "kind": "mcp",
      "err": "token expired",
      "fix": "⏎ sign in"
    },
    {
      "n": "linear",
      "d": "issues and cycles",
      "on": false,
      "kind": "mcp"
    }
