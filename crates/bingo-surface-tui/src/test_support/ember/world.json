      }
    },
    {
      "name": "bo",
      "c": "crew3",
      "role": "runs releases and watches CI",
      "model": {
        "id": "haiku-5.5",
        "eff": "low"
      }
    }
  ],
  "pastScript": [
    {
      "k": "think",
      "at": 0,
      "ms": 600,
      "text": "这是另一个会话。"
    },
    {
      "k": "step",
      "at": 700,
      "end": 900,
      "tool": "read",
      "arg": "README.md",
      "st": "ok",
      "tail": [],
      "res": "88 lines"
    },
    {
      "k": "narr",
      "at": 1000,
      "text": "这是「{title}」会话的最后一轮。往下接着说就行。"
    }
  ],
  "echoScript": [
    {
      "k": "think",
      "at": 0,
      "ms": 500,
      "text": "原型里的回答是预先写好的。"
    },
    {
      "k": "narr",
      "at": 600,
      "text": "收到「{text}」。这是原型，回答是预先写好的；试试「{T2P}」，看完整的一轮：读文件、改代码、跑测试、失败、修好。"
    }
  ]
}
