{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "type": "object",
  "properties": {
    "model": {
      "$ref": "#/$defs/Script"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step2"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "model",
    "steps"
  ],
  "$defs": {
    "Script": {
      "description": "Everything the provider will say, in order.",
      "type": "object",
      "properties": {
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Response"
          }
        },
        "side": {
          "description": "What a side question — a plugin's, asked beside the conversation and\nmarked `provider_options.bingo.purpose` — is answered with, in order;\npast the end of this list, with nothing. The conversation's responses\nare never spent on one.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Response"
          }
        }
      },
      "required": [
        "responses"
      ]
    },
    "Response": {
      "description": "One provider response: what a single `stream()` call yields.",
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "finish": {
          "description": "Overrides the finish reason derived from the steps.",
          "anyOf": [
            {
              "$ref": "#/$defs/UnifiedFinish"
            },
            {
              "type": "null"
            }
          ]
        },
        "when": {
          "description": "Which requests may take this response. Without one it goes to whichever\nsession asks next; with one it is passed over until its own asker comes.",
          "anyOf": [
            {
              "$ref": "#/$defs/Match"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "steps"
      ]
    },
    "Step": {
      "description": "One block of a response.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "reasoning": {
              "type": "string"
            }
          },
          "required": [
            "reasoning"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "toolCall": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "input": true
              },
              "required": [
                "name",
                "input"
              ]
            }
          },
          "required": [
            "toolCall"
          ],
          "additionalProperties": false
        },
        {
          "description": "The stream yields this error and ends.",
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/ProviderError"
            }
          },
          "required": [
            "error"
          ],
          "additionalProperties": false
        },
        {
          "description": "Sleeps on the tokio timer, so tests can drive it with `tokio::time::pause`.",
          "type": "object",
          "properties": {
            "delay": {
              "type": "object",
              "properties": {
                "ms": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "required": [
                "ms"
              ]
            }
          },
          "required": [
            "delay"
          ],
          "additionalProperties": false
        },
        {
          "description": "Sleeps before the stream exists at all: the time to first byte a real\nendpoint spends establishing the request. Wherever it stands among the\nsteps, it is waited out first, because that is when it happens.",
          "type": "object",
          "properties": {
            "delayBeforeStream": {
              "type": "object",
              "properties": {
                "ms": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                }
              },
              "required": [
                "ms"
              ]
            }
          },
          "required": [
            "delayBeforeStream"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ProviderError": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "auth"
            }
          },
          "required": [
            "kind",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "retryAfterMs": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "rateLimited"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "contextOverflow"
            }
          },
          "required": [
            "kind",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "integer",
              "format": "uint16",
              "minimum": 0,
              "maximum": 65535
            },
            "message": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "server"
            }
          },
          "required": [
            "kind",
            "status",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "request"
            }
          },
          "required": [
            "kind",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "transport"
            }
          },
          "required": [
            "kind",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "stream"
            }
          },
          "required": [
            "kind",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "timeout"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "unsupported"
            }
          },
          "required": [
            "kind",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "config"
            }
          },
          "required": [
            "kind",
            "message"
          ]
        }
      ]
    },
    "UnifiedFinish": {
      "type": "string",
      "enum": [
        "stop",
        "length",
        "toolCalls",
        "contentFilter",
        "error",
        "other"
      ]
    },
    "Match": {
      "description": "What a response waits for: a way of recognising the request it was written\nfor, so a script shared by several sessions can address a turn instead of\nracing for it.",
      "oneOf": [
        {
          "description": "The request carries this text somewhere — its system prompt, a message,\na tool call's input, or a tool result. Pick something only the intended\nsession can have said or been told.",
          "type": "object",
          "properties": {
            "contains": {
              "type": "string"
            }
          },
          "required": [
            "contains"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Step2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "submit": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "text"
              ]
            }
          },
          "required": [
            "submit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "reload": {
              "type": "object",
              "additionalProperties": false
            }
          },
          "required": [
            "reload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "expect": {
              "$ref": "#/$defs/Expectation"
            }
          },
          "required": [
            "expect"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Expectation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "slot": {
              "type": "object",
              "properties": {
                "slot": {
                  "type": "string"
                },
                "contains": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "slot",
                "contains"
              ]
            }
          },
          "required": [
            "slot"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tool": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "contains": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "contains"
              ]
            }
          },
          "required": [
            "tool"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "denied": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "denied"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "notice": {
              "type": "object",
              "properties": {
                "contains": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "contains"
              ]
            }
          },
          "required": [
            "notice"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
